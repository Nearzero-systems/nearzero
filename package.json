{
  "name": "nearzero",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*",
    "apps/*",
    "runner",
    "e2e"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run --filter '@nearzero/control' --filter '@nearzero/console' --filter '@nearzero/runner' build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p . && bun run --filter '@nearzero/*' typecheck",
    "test": "bun test ./packages ./apps ./runner ./installer",
    "test:e2e": "bun run --cwd e2e test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.3.10",
    "typescript": "6.0.3"
  }
}
