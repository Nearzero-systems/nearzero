---
import { publicFooterGroups } from "@/lib/public-site";

const year = new Date().getFullYear();
const groups = publicFooterGroups;
const maxItems = Math.max(...groups.map((group) => 1 + group.links.length));
const firstContentRow = 2;
const lastContentRow = firstContentRow + maxItems - 1;
const creditRow = lastContentRow + 1;
const rowCount = creditRow;
const sideCols = [1, 2, 11, 12];

const sideTiles = [];
for (let row = 1; row <= rowCount; row += 1) {
	for (const col of sideCols) {
		sideTiles.push({ row, col });
	}
}

const columns = groups.map((group, index) => {
	const usedRows = 1 + group.links.length;
	const padStart = firstContentRow + usedRows;
	return {
		group,
		index,
		padStart: padStart <= lastContentRow ? padStart : null,
	};
});
---

<footer class="nz-footer">
	<div class="nz-footer__board">
		{
			sideTiles.map((tile) => (
				<div
					class="nz-footer__tile nz-footer__tile--side"
					aria-hidden="true"
					style={`--nz-c:${tile.col};--nz-r:${tile.row}`}
				/>
			))
		}
		<div class="nz-footer__top" aria-hidden="true"></div>
		<nav class="nz-footer__nav" aria-label="Footer">
			{
				columns.map(({ group, index, padStart }) => (
					<div class="nz-footer__col" data-col={index}>
						<p class="nz-footer__heading" style={`--nz-r:${firstContentRow}`}>
							{group.title}
						</p>
						{group.links.map((link, linkIndex) => (
							<a
								class="nz-footer__cell"
								href={link.href}
								style={`--nz-r:${firstContentRow + 1 + linkIndex}`}
							>
								{link.label}
							</a>
						))}
						{padStart !== null && (
							<div
								class="nz-footer__tile nz-footer__tile--pad"
								aria-hidden="true"
								style={`--nz-r:${padStart};--nz-r-end:${lastContentRow + 1}`}
							/>
						)}
					</div>
				))
			}
		</nav>
		<p class="nz-footer__credit" style={`--nz-r:${creditRow}`}>
			© {year} Nearzero Systems
		</p>
	</div>
</footer>
