<script>
	import { animate, inView, stagger } from "framer-motion/dom";

	const body = document.body;
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (body.dataset.nzMotionBound !== "true" && !reduceMotion) {
		body.dataset.nzMotionBound = "true";

		const easing = [0.22, 1, 0.36, 1] as const;
		const pending = new Set<HTMLElement>();

		const uniqueElements = (selectors: string[]): HTMLElement[] => [
			...new Set(
				selectors.flatMap((selector) => [
					...document.querySelectorAll<HTMLElement>(selector),
				]),
			),
		];

		const isInInitialView = (element: HTMLElement) => {
			const rect = element.getBoundingClientRect();
			return rect.bottom > 24 && rect.top < window.innerHeight * 0.88;
		};

		const prepare = (elements: HTMLElement[], distance = 22) => {
			const queued: HTMLElement[] = [];

			for (const element of elements) {
				if (element.closest(".nz-land-gap, .nz-footer")) continue;
				if (element.dataset.nzMotionPending === "true") continue;

				element.style.opacity = "0";
				element.style.transform = `translateY(${distance}px)`;
				element.style.willChange = "opacity, transform";
				element.dataset.nzMotionPending = "true";
				pending.add(element);
				queued.push(element);
			}

			return queued;
		};

		const finish = (elements: HTMLElement[]) => {
			for (const element of elements) {
				element.style.removeProperty("opacity");
				element.style.removeProperty("transform");
				element.style.removeProperty("will-change");
				delete element.dataset.nzMotionPending;
				pending.delete(element);
			}
		};

		const reveal = (
			elements: HTMLElement[],
			options: { delay?: number | ReturnType<typeof stagger>; duration?: number } = {},
		) => {
			if (elements.length === 0) return;

			animate(
				elements,
				{ opacity: 1, transform: "translateY(0px)" },
				{
					delay: options.delay ?? 0,
					duration: options.duration ?? 0.58,
					ease: easing,
					onComplete: () => finish(elements),
				},
			);
		};

		const watch = (
			trigger: HTMLElement,
			queued: HTMLElement[],
			options: { delay?: number | ReturnType<typeof stagger>; duration?: number } = {},
		) => {
			if (queued.length === 0) return;

			if (isInInitialView(trigger)) {
				reveal(queued, { ...options, duration: options.duration ?? 0.5 });
				return;
			}

			let hasRevealed = false;
			inView(
				trigger,
				() => {
					if (hasRevealed) return;
					hasRevealed = true;
					reveal(queued, options);
				},
				{ amount: 0.08, margin: "0px 0px -12% 0px" },
			);
		};

		watch(
			document.querySelector(".nz-hero__copy") ?? body,
			prepare(
				uniqueElements([
					".nz-hero__copy",
					".nz-docs-page__header",
					".nz-docs-hero > .nz-container",
				]),
				16,
			),
			{ delay: stagger(0.05), duration: 0.52 },
		);

		for (const element of uniqueElements([
			".nz-land-board__intro",
			".nz-land-board__visual",
			".nz-faq-board__intro",
			".nz-faq-board__visual",
			".nz-docs-page__header",
			".nz-doc-section",
			".nz-docs-pager",
			".nz-doc-pager",
		])) {
			watch(element, prepare([element], 24), { duration: 0.62 });
		}

		const staggerGroups = [
			[".nz-land-board__body", ":scope > .nz-land-tile, :scope > a.nz-land-tile"],
			[".nz-faq-board__body", ":scope > .nz-faq-board__group"],
			[".nz-footer__nav", ".nz-footer__heading, .nz-footer__cell"],
			[".nz-docs-article", ":scope > *"],
			[".nz-docs-rail", ".nz-docs-rail__group"],
		] as const;

		for (const [groupSelector, childSelector] of staggerGroups) {
			for (const group of document.querySelectorAll<HTMLElement>(groupSelector)) {
				const children = [...group.querySelectorAll<HTMLElement>(childSelector)];
				watch(group, prepare(children, 18), {
					delay: stagger(0.05),
					duration: 0.5,
				});
			}
		}

		const footer = document.querySelector<HTMLElement>(".nz-footer");
		if (footer) {
			watch(footer, prepare([footer], 16), { duration: 0.55 });
		}

		window.addEventListener("beforeprint", () => finish([...pending]));
	}
</script>
