---
// biome-ignore-all lint/correctness/noUnusedImports: Astro resolves frontmatter bindings in the template.
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import type { ComparisonPage } from "@/lib/comparisons";
import { comparisons } from "@/lib/comparisons";
import { publicSiteLinks } from "@/lib/public-site";
import "@/styles/landing.css";
import LandingBoard from "./LandingBoard.astro";
import MarketingFooter from "./MarketingFooter.astro";
import MarketingHeader from "./MarketingHeader.astro";
import MastheadBoard from "./MastheadBoard.astro";

interface Props {
	comparison: ComparisonPage;
}

const { comparison } = Astro.props;
const otherComparisons = comparisons.filter(
	(item) => item.slug !== comparison.slug,
);

const firstSentence = (text: string) => {
	const index = text.indexOf(". ");
	return index > 0 ? text.slice(0, index + 1) : text;
};

const salesUrl = "mailto:contact@nearzero.dev?subject=Nearzero%20walkthrough";

const seoTitles: Record<ComparisonPage["slug"], string> = {
	vercel: "Nearzero vs Vercel — keep the server",
	netlify: "Nearzero vs Netlify — a control plane, not an edge for sites",
	coolify: "Nearzero vs Coolify — placement, DNS, and a locked-down Agent",
};

const socialAlts: Record<ComparisonPage["slug"], string> = {
	vercel:
		"Nearzero versus Vercel: owned servers versus managed cloud infrastructure.",
	netlify:
		"Nearzero versus Netlify: self-hosted workloads versus managed web hosting.",
	coolify:
		"Nearzero versus Coolify: self-hosted deployment platforms compared.",
};

const faqSchema = {
	"@type": "FAQPage",
	mainEntity: comparison.faqs.map((faq) => ({
		"@type": "Question",
		name: faq.question,
		acceptedAnswer: { "@type": "Answer", text: faq.answer },
	})),
};
---


<MarketingLayout
	kind="webpage"
	title={seoTitles[comparison.slug]}
	description={comparison.description}
	canonical={`/compare/${comparison.slug}`}
	breadcrumbLabel={comparison.title}
	socialImageAlt={socialAlts[comparison.slug]}
	schemaGraph={[faqSchema]}
>
	<div class="nz-marketing">
		<MastheadBoard compact>
			<MarketingHeader slot="header" active="compare" />
			<section slot="hero" class="nz-hero" id="main-content" aria-labelledby="nz-compare-hero-heading">
				<div class="nz-container">
					<div class="nz-hero__copy">
						<h1 id="nz-compare-hero-heading">Nearzero vs {comparison.competitor}</h1>
						<p class="nz-hero__lede">{comparison.summary}</p>
						<div class="nz-hero__actions">
							<a class="nz-button nz-button--primary" href="#why">
								Where Nearzero wins
								<span aria-hidden="true">↓</span>
							</a>
						</div>
					</div>
				</div>
			</section>
		</MastheadBoard>

		<main>
			<LandingBoard kicker="Why" headingId="nz-compare-why-heading" id="why" bodyClass="nz-land-board__body--split">
				<Fragment slot="intro">
					<h2 id="nz-compare-why-heading">Where Nearzero wins.</h2>
					<p>These are the jobs {comparison.competitor} does not give you.</p>
				</Fragment>
				{
					comparison.chooseNearzero.map((item, index) => (
						<article class="nz-land-tile">
							<span class="nz-land-tile__kicker">{String(index + 1).padStart(2, "0")}</span>
							<h3>{item.title}</h3>
							<p>{item.copy}</p>
						</article>
					))
				}
			</LandingBoard>

			<LandingBoard kicker="Table" headingId="nz-compare-table-heading" id="capabilities" bodyClass="nz-land-board__body--docs">
				<Fragment slot="intro">
					<h2 id="nz-compare-table-heading">The gap, row by row.</h2>
					<p>Read the competitor column as what you give up — not as a feature list for them.</p>
				</Fragment>
				<div class="nz-land-tile nz-land-tile--wide nz-land-tile--table">
					<table class="nz-land-table">
						<caption>Nearzero and {comparison.competitor} capability comparison</caption>
						<thead>
							<tr>
								<th scope="col">Area</th>
								<th scope="col">Nearzero</th>
								<th scope="col">{comparison.competitor}</th>
								<th scope="col">What you get</th>
							</tr>
						</thead>
						<tbody>
							{
								comparison.rows.map((row) => (
									<tr>
										<th scope="row">{row.capability}</th>
										<td>
											<span class:list={["nz-land-status", `is-${row.nearzero.tone}`]}>
												{row.nearzero.value}
											</span>
										</td>
										<td>
											<span class:list={["nz-land-status", `is-${row.competitor.tone}`]}>
												{row.competitor.value}
											</span>
										</td>
										<td>{row.implication}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</LandingBoard>

			<LandingBoard kicker="Unlock" headingId="nz-compare-unlock-heading" id="unlock" bodyClass="nz-land-board__body--split">
				<Fragment slot="intro">
					<h2 id="nz-compare-unlock-heading">What that unlocks.</h2>
					<p>Control stays on the host. Nearzero builds, deploys, and routes.</p>
				</Fragment>
				{
					comparison.implications.map((item) => (
						<article class="nz-land-tile">
							<span class="nz-land-tile__kicker">Outcome</span>
							<h3>{item.title}</h3>
							<p>{item.copy}</p>
						</article>
					))
				}
			</LandingBoard>

			<LandingBoard kicker="FAQ" headingId="nz-compare-faq-heading" id="faq" bodyClass="nz-land-board__body--faq">
				<Fragment slot="intro">
					<h2 id="nz-compare-faq-heading">Nearzero vs {comparison.competitor} FAQ</h2>
					<p>Short answers for why this control plane belongs on your servers.</p>
				</Fragment>
				{
					comparison.faqs.map((faq) => (
						<details class="nz-land-tile nz-land-faq">
							<summary>
								<h3>{faq.question}</h3>
								<i aria-hidden="true"></i>
							</summary>
							<p>{faq.answer}</p>
						</details>
					))
				}
			</LandingBoard>

			<LandingBoard kicker="Compare" headingId="nz-compare-related-heading" id="related" bodyClass="nz-land-board__body--uses">
				<Fragment slot="intro">
					<h2 id="nz-compare-related-heading">Keep going.</h2>
					<p>Same thesis. Different gap.</p>
				</Fragment>
				{
					otherComparisons.map((item) => (
						<a class="nz-land-tile nz-land-tile--link" href={`/compare/${item.slug}`}>
							<span class="nz-land-tile__kicker">
								{item.category === "managed-platform" ? "Managed" : "Self-hosted"}
							</span>
							<h3>Nearzero vs {item.competitor}</h3>
							<p>{firstSentence(item.summary)}</p>
							<span class="nz-text-link">
								Read comparison <span aria-hidden="true">→</span>
							</span>
						</a>
					))
				}
			</LandingBoard>

			<LandingBoard kicker="Call" headingId="nz-compare-walk-heading" id="walkthrough" bodyClass="nz-land-board__body--split">
				<Fragment slot="intro">
					<h2 id="nz-compare-walk-heading">Map this to the servers you have.</h2>
					<p>Thirty minutes against the hosts, DNS, and Compose you actually run.</p>
				</Fragment>
				<article class="nz-land-tile nz-land-tile--cta">
					<div class="nz-land-tile__copy">
						<span class="nz-land-tile__kicker">Book</span>
						<h3>Walk through Nearzero vs {comparison.competitor}.</h3>
						<p>Bring what you run today. We will say when Nearzero is the wrong install.</p>
						<ul class="nz-land-checks">
							<li>Whether the job is a control plane on servers you operate</li>
							<li>Where Compose, databases, and placement actually matter</li>
							<li>DNS, HTTPS, and who owns the box after deploy</li>
						</ul>
					</div>
					<div class="nz-land-actions">
						<a
							class="nz-button nz-button--primary"
							href={salesUrl}
						>
							Book a 30-minute walkthrough
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</article>
				<article class="nz-land-tile">
					<span class="nz-land-tile__kicker">Format</span>
					<h3>What the half-hour is.</h3>
					<p>A working session, not a pitch deck.</p>
					<ul class="nz-land-checks">
						<li>Current setup and the hosts you already pay for</li>
						<li>This comparison against those constraints</li>
						<li>Next step: install Nearzero, or stay where you are</li>
					</ul>
				</article>
			</LandingBoard>

			<LandingBoard kicker="Guides" headingId="nz-compare-next-heading" id="get-started" bodyClass="nz-land-board__body--cta" gapAfter={false}>
				<Fragment slot="intro">
					<h2 id="nz-compare-next-heading">If this pointed at Nearzero, install it.</h2>
					<p>Own the host first. Then put the control plane on it.</p>
				</Fragment>
				<article class="nz-land-tile nz-land-tile--cta">
					<div class="nz-land-tile__copy">
						<span class="nz-land-tile__kicker">Install</span>
						<h3>Self-hosting guide</h3>
						<p>Dedicated Linux host, DNS, HTTPS, and the first deploy.</p>
					</div>
					<div class="nz-land-actions">
						<a class="nz-button nz-button--primary" href={publicSiteLinks.selfHosting}>
							Open the install guide
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</article>
				<article class="nz-land-tile">
					<div class="nz-land-tile__copy">
						<span class="nz-land-tile__kicker">Keep comparing</span>
						<h3>Other platforms</h3>
						<p>Vercel, Netlify, and Coolify — what they do not give you.</p>
					</div>
					<div class="nz-land-actions">
						<a class="nz-button nz-button--secondary" href={publicSiteLinks.compare}>
							All comparisons
						</a>
					</div>
				</article>
			</LandingBoard>
		</main>

		<MarketingFooter />
	</div>
</MarketingLayout>
