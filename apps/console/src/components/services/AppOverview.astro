---
import type { DeploymentView, ServiceDetail, ServiceHostnames } from "../../lib/data/index.ts";
import { sourceFacts } from "../../lib/git-providers.ts";
import { applicationSource, SERVICE_STATUS } from "../../lib/projects.ts";
import { appSource } from "../../lib/runtime-rules.ts";
import DeployLive from "../deploys/DeployLive.astro";
import DeploymentsPanel from "../deploys/DeploymentsPanel.astro";
import Fold from "../ui/Fold.astro";
import Tabs from "../ui/Tabs.astro";
import AppDomainFact from "./AppDomainFact.astro";
import BuildPanel from "./BuildPanel.astro";
import GitUrlSourceTab from "./GitUrlSourceTab.astro";
import ImageSourceTab from "./ImageSourceTab.astro";
import ProviderSourceTab from "./ProviderSourceTab.astro";
import UploadSourceTab from "./UploadSourceTab.astro";

/**
 * An application's Overview (spec 06 6.3, 21.10): the summary card (Domain, Status, Source,
 * Branch, Repository, then Container), then one box of folds: Source (closed; a tab per kind of
 * source), Build (not for images) and Deployments (open), with the live build log above while a
 * deploy runs.
 */
interface Props {
  service: ServiceDetail;
  workspace: string;
  hostnames: ServiceHostnames | null;
  /** The generated hostname a Create URL would give, when there is one. */
  suggested: string | null;
  deployments: DeploymentView[];
  sshKeys: { id: string; name: string }[] | null;
}

const { service, workspace, hostnames, suggested, deployments, sshKeys } = Astro.props;
const shownSource = appSource(service.settings);
const source = applicationSource(service);
const status = SERVICE_STATUS[service.status];
const providers = ["GitHub", "GitLab", "Bitbucket", "Gitea"];
// A repository through a connected provider opens on its provider's tab (spec 6.3).
const facts = sourceFacts(service);
const providerKind = (service.settings.source as { provider?: string } | null)?.provider;
const selectedTab =
  facts &&
  typeof providerKind === "string" &&
  providers.some((name) => name.toLowerCase() === providerKind)
    ? providerKind
    : shownSource.type === "git"
      ? "git-url"
      : shownSource.type === "upload"
        ? "upload"
        : "image";
// The image name for an image source (spec 21.10: REPOSITORY shows "nginx:alpine").
const repository = facts?.repository ?? shownSource.url ?? source?.image ?? null;
const tabs = [
  ...providers.map((name) => ({ id: name.toLowerCase(), label: name })),
  { id: "image", label: "Image" },
  { id: "git-url", label: "Git URL" },
  { id: "upload", label: "Upload" },
];
---

<div class="nz-stack">
  <DeployLive service={service} />
  <section class="nz-card nz-summary" aria-labelledby="nz-app-facts">
    <h2 class="nz-visually-hidden" id="nz-app-facts">Summary</h2>
    <div class="nz-summary-row nz-summary-row--app">
      <AppDomainFact service={service} hostnames={hostnames} suggested={suggested} />
      <div class="nz-fact">
        <span class="nz-eyebrow">Status</span>
        <span class="nz-fact-status" data-status={status.pill}>{status.label}</span>
      </div>
      <div class="nz-fact">
        <span class="nz-eyebrow">Source</span>
        <span>
          {facts
            ? facts.source
            : shownSource.type === "git"
              ? "Git URL"
              : shownSource.type === "upload"
                ? "Uploaded archive"
                : source
                  ? "Docker"
                  : "Not set yet"}
        </span>
      </div>
      <div class="nz-fact">
        <span class="nz-eyebrow">Branch</span>
        {facts?.branch || shownSource.branch ? <span class="nz-code">{facts?.branch ?? shownSource.branch}</span> : <span>—</span>}
      </div>
      <div class="nz-fact">
        <span class="nz-eyebrow">Repository</span>
        {repository ? <span class="nz-truncate" title={repository}>{repository}</span> : <span>—</span>}
      </div>
    </div>
    <div class="nz-summary-row nz-summary-row--below">
      <div class="nz-fact">
        <span class="nz-eyebrow">Container</span>
        {service.status === "idle" ? <span class="nz-dim">Not deployed</span> : <span class="nz-code-strip">{service.appName}</span>}
      </div>
    </div>
  </section>

  <div class="nz-folds">
    <Fold title="Source" info="Where this app's code or image comes from." id={`nz-source-fold-${service.id}`}>
      <Tabs id={`nz-source-${service.id}`} label="Source" tabs={tabs} selected={selectedTab}>
        <ProviderSourceTab slot="github" service={service} workspace={workspace} kind="github" />
        <ProviderSourceTab slot="gitlab" service={service} workspace={workspace} kind="gitlab" />
        <ProviderSourceTab slot="bitbucket" service={service} workspace={workspace} kind="bitbucket" />
        <ProviderSourceTab slot="gitea" service={service} workspace={workspace} kind="gitea" />
        <ImageSourceTab slot="image" service={service} />
        <GitUrlSourceTab slot="git-url" service={service} sshKeys={sshKeys} />
        <UploadSourceTab slot="upload" service={service} />
      </Tabs>
    </Fold>

    {shownSource.type !== "image" && <BuildPanel service={service} />}

    <DeploymentsPanel serviceName={service.name} deployments={deployments} />
  </div>
</div>
