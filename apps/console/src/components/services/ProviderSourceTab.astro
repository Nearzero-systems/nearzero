---
import {
  DEFAULT_COMPOSE_PATH,
  GIT_PROVIDER_LABELS,
  type GitProviderKind,
  NO_GIT_SOURCE,
  noAccountsMessage,
} from "@nearzero/shared/browser";
import { consoleData, type ServiceDetail } from "../../lib/data/index.ts";
import { connectPath } from "../../lib/git-providers.ts";
import { settingsPath } from "../../lib/routes.ts";
import Button from "../ui/Button.astro";
import CopyButton from "../ui/CopyButton.astro";
import Field from "../ui/Field.astro";
import FormError from "../ui/FormError.astro";
import Switch from "../ui/Switch.astro";

/**
 * One provider's tab in a service's Source panel (spec 6.3 for applications, 7.2 for Compose):
 * account, repository, branch, build path (or the Compose file path), trigger (GitHub), watch
 * paths typed and entered, submodules, and "Save & deploy" (or "Save"). A repository linked
 * through an account the viewer can't use shows "Disconnect repository"; one whose provider was
 * deleted shows "No Git source". GitLab, Bitbucket and Gitea show how pushes arrive: the webhook
 * Nearzero added, or the steps to add it by hand (URL and secret for people who can deploy).
 */
interface Props {
  service: ServiceDetail;
  workspace: string;
  kind: GitProviderKind;
  compose?: boolean;
}

const { service, workspace, kind, compose = false } = Astro.props;
const data = consoleData(Astro);
const [usable, view] = await Promise.all([
  data.usableGitProviders().catch(() => ({ providers: [], canConnect: false })),
  data.gitSource(service.id),
]);
const label = GIT_PROVIDER_LABELS[kind];
const accounts = usable.providers.filter((provider) => provider.kind === kind && provider.ready);
const source = view?.source && view.source.provider === kind ? view.source : null;
const state = source ? view?.state : "none";
const prefix = `nz-src-${kind}-${service.id.slice(0, 8)}`;
const configure = service.can.configure;
const selectedAccount = source?.providerId ?? accounts[0]?.id ?? "";
const here = Astro.url.pathname;
const push = source ? view?.push : null;
---

<div class="nz-stack-sm" data-git-source-tab={kind} data-service-id={service.id}>
  {
    state === "no_access" && source && (
      <div class="nz-stack-sm">
        <p class="nz-inline-note">
          {source.repository} ({source.branch}) is linked through a {label} account you can't use, so its settings are hidden.
        </p>
        {configure && (
          <div>
            <Button variant="outline" icon="trash" data-git-disconnect={service.id}>Disconnect repository</Button>
          </div>
        )}
      </div>
    )
  }
  {
    state === "no_git_source" && source && (
      <p class="nz-inline-note nz-warn-note">
        <strong>{NO_GIT_SOURCE}</strong>: the {label} provider of {source.repository} was deleted. Pick another account to keep deploying from it.
      </p>
    )
  }
  {
    state !== "no_access" && accounts.length === 0 && (
      <p class="nz-inline-note">
        {noAccountsMessage(kind)}{" "}
        {usable.canConnect ? (
          <a class="nz-text-link" href={connectPath(workspace, kind, here)}>Connect {label} in Settings</a>
        ) : (
          <a class="nz-text-link" href={settingsPath(workspace, "git-providers")}>Git providers</a>
        )}
      </p>
    )
  }
  {
    state !== "no_access" && accounts.length > 0 && (
      <form
        class="nz-form"
        data-api="PUT /services/{serviceId}/git-source"
        data-api-manual
        data-api-toast="Source saved"
        data-git-source-form={kind}
        data-deploy-on-save={service.can.deploy ? service.id : undefined}
        novalidate
      >
        <input type="hidden" name="serviceId" value={service.id} />
        <div class="nz-form-grid-2">
          <Field
            id={`${prefix}-account`}
            name="providerId"
            label="Account"
            as="select"
            options={accounts.map((account) => ({
              value: account.id,
              label: account.account ? `${account.name} (${account.account})` : account.name,
              selected: account.id === selectedAccount,
            }))}
            disabled={!configure}
            data-git-source-account
          />
          <Field
            id={`${prefix}-repo`}
            name="repository"
            label="Repository"
            value={source?.repository ?? ""}
            placeholder="owner/repository"
            autocomplete="off"
            spellcheck="false"
            list={`${prefix}-repos`}
            disabled={!configure}
            data-git-source-repo
          />
          <Field
            id={`${prefix}-branch`}
            name="branch"
            label="Branch"
            value={source?.branch ?? ""}
            placeholder="The repository's default branch"
            autocomplete="off"
            spellcheck="false"
            list={`${prefix}-branches`}
            disabled={!configure}
            data-git-source-branch
          />
          {
            compose ? (
              <Field
                id={`${prefix}-compose`}
                name="composePath"
                label="Compose file path"
                value={source?.composePath ?? DEFAULT_COMPOSE_PATH}
                autocomplete="off"
                spellcheck="false"
                disabled={!configure}
              />
            ) : (
              <Field
                id={`${prefix}-path`}
                name="buildPath"
                label="Build path"
                value={`/${source?.buildPath ?? ""}`}
                autocomplete="off"
                spellcheck="false"
                disabled={!configure}
              />
            )
          }
          {
            kind === "github" && (
              <Field
                id={`${prefix}-trigger`}
                name="trigger"
                label="Trigger"
                as="select"
                options={[
                  { value: "push", label: "On push", selected: source?.trigger !== "tag" },
                  { value: "tag", label: "On tag", selected: source?.trigger === "tag" },
                ]}
                disabled={!configure}
              />
            )
          }
        </div>
        <datalist id={`${prefix}-repos`} data-git-source-repos></datalist>
        <datalist id={`${prefix}-branches`} data-git-source-branches></datalist>
        <div data-field data-git-watch>
          <label class="nz-label" for={`${prefix}-watch`}>Watch paths</label>
          <div class="nz-git-chiplist" data-git-watch-list>
            {
              (source?.watchPaths ?? []).map((path) => (
                <span class="nz-git-chip" data-git-watch-path={path}>
                  {path}
                  {configure && (
                    <button type="button" aria-label={`Remove ${path}`} data-git-watch-remove>
                      ×
                    </button>
                  )}
                </span>
              ))
            }
          </div>
          {
            configure && (
              <input
                id={`${prefix}-watch`}
                class="nz-input mt-2"
                placeholder="src/** then Enter"
                autocomplete="off"
                spellcheck="false"
                data-git-watch-input
              />
            )
          }
          <p class="nz-hint">With watch paths, a push deploys only when a changed file matches one; start one with ! to leave files out. Leave empty to deploy every push.</p>
          <p class="nz-field-error" data-field-error hidden></p>
        </div>
        <div class="nz-switch-list">
          <Switch
            id={`${prefix}-submodules`}
            name="submodules"
            label="Submodules"
            description="Fetch the repository's submodules too."
            checked={source?.submodules ?? false}
            disabled={!configure}
            data-json="bool"
          />
        </div>
        <FormError />
        {
          configure && (
            <div class="nz-form-actions">
              {source && (
                <Button variant="ghost" data-git-disconnect={service.id}>Disconnect repository</Button>
              )}
              <Button variant="primary" type="submit">{service.can.deploy ? "Save & deploy" : "Save"}</Button>
            </div>
          )
        }
      </form>
    )
  }
  {
    push && state === "connected" && (
      <div class="nz-stack-sm mt-2" data-git-push>
        <span class="nz-label">Push deploys</span>
        <p class:list={["nz-inline-note", (push.status === "manual" || push.status === "stale" || push.status === "none") && "nz-warn-note"]}>
          {push.message}
        </p>
        {push.mode === "webhook" && push.hidden && <p class="nz-hint">{push.hidden}</p>}
        {
          push.mode === "webhook" && push.steps.length > 0 && (
            <ol class="nz-git-steps">
              {push.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          )
        }
        {
          push.url && push.status !== "registered" && (
            <div class="nz-git-secret">
              <span class="nz-dim">URL</span>
              <code class="nz-code">{push.url}</code>
              <CopyButton text={push.url} what="webhook URL" />
            </div>
          )
        }
        {
          push.secret && push.status !== "registered" && (
            <div class="nz-git-secret">
              <span class="nz-dim">Secret</span>
              <code class="nz-code nz-masked" data-git-secret>{push.secret}</code>
              <CopyButton text={push.secret} what="webhook secret" />
            </div>
          )
        }
        {
          push.mode === "webhook" && configure && push.status !== "registered" && (
            <div>
              <Button variant="outline" icon="refresh" data-git-register={service.id}>Register webhook</Button>
            </div>
          )
        }
      </div>
    )
  }
</div>
