---
import type { ServiceDetail } from "../../lib/data/index.ts";
import { appSource } from "../../lib/runtime-rules.ts";
import Button from "../ui/Button.astro";
import Field from "../ui/Field.astro";
import FormError from "../ui/FormError.astro";

/**
 * The Source panel's Image tab (spec 6.3): the image (required) and a private registry's address,
 * user name and password ("Stored — leave blank to keep"). Saved with PUT …/source, then deployed
 * when the person may deploy ("Save & deploy").
 */
interface Props {
  service: ServiceDetail;
}

const { service } = Astro.props;
const source = appSource(service.settings);
const image = source.type === "image" ? source : null;
const registry = image?.registry ?? null;
---

<form
  class="nz-form"
  data-api="PUT /services/{serviceId}/source"
  data-api-toast="Source saved"
  data-deploy-on-save={service.can.deploy ? service.id : undefined}
  data-image-source
  data-api-manual
  data-validate
  novalidate
>
  <input type="hidden" name="serviceId" value={service.id} />
  <input type="hidden" name="type" value="image" />
  <Field
    id="nz-src-image"
    name="image"
    label="Image"
    value={image?.image ?? ""}
    placeholder="nginx:alpine or ghcr.io/acme/api:1.2.0"
    autocomplete="off"
    spellcheck="false"
    data-required="Enter an image, like nginx:alpine."
    disabled={!service.can.configure}
  />
  <div class="nz-form-grid-2">
    <Field
      id="nz-src-registry"
      name="registry.address"
      label="Registry address"
      value={registry?.address ?? ""}
      placeholder="ghcr.io"
      autocomplete="off"
      spellcheck="false"
      disabled={!service.can.configure}
    />
    <Field
      id="nz-src-registry-user"
      name="registry.username"
      label="User name"
      value={registry?.username ?? ""}
      autocomplete="off"
      spellcheck="false"
      disabled={!service.can.configure}
    />
    <Field
      id="nz-src-registry-password"
      name="registry.password"
      label="Password"
      type="password"
      autocomplete="new-password"
      placeholder={registry?.passwordSet ? "Stored — leave blank to keep" : "Registry password or token"}
      disabled={!service.can.configure}
      data-1p-ignore
    />
  </div>
  <p class="nz-hint">Leave the registry empty for public images. The password is stored encrypted and never shown again.</p>
  <FormError />
  {
    service.can.configure && (
      <div class="nz-form-actions">
        <Button variant="primary" type="submit">{service.can.deploy ? "Save & deploy" : "Save"}</Button>
      </div>
    )
  }
</form>
