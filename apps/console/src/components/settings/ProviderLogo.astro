---
import type { GitProviderKind } from "@nearzero/shared/browser";

/**
 * A small coloured mark for each Git provider on Settings → Git providers (spec 16.1, 21.10):
 * a dark cat head for GitHub, an orange fox for GitLab, a blue bucket for Bitbucket and a green
 * cup for Gitea. Simple shapes drawn for Nearzero, not the providers' own artwork.
 */
interface Props {
  kind: GitProviderKind;
  size?: number;
}

const { kind, size = 14 } = Astro.props;
---

<svg
  class:list={["nz-provider-logo", `nz-provider-logo--${kind}`]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  {
    kind === "github" ? (
      <>
        <circle cx="12" cy="12" r="11" fill="currentColor" />
        <path
          d="M7.2 8.6 7 5.4l2.6 1.7c1.5-.4 3.3-.4 4.8 0L17 5.4l-.2 3.2c.7.8 1 1.8 1 2.9 0 2.9-2.2 4.4-4.6 4.7.6.5.8 1.2.8 2v2.6h-4v-2.2c-1.6.3-2.6-.4-3.1-1.6-.3-.6-.7-.9-1.1-1.1.7-.2 1.2.2 1.6.8.4.6 1 1 2 .8 0-.5.2-.9.5-1.3-2.4-.3-4.6-1.8-4.6-4.7 0-1.1.3-2.1.9-2.9Z"
          fill="var(--nz-provider-logo-cut, #ffffff)"
        />
      </>
    ) : kind === "gitlab" ? (
      <>
        <path d="M12 21.5 2.2 13.4l2.3-9.2 2.9 7.3h9.2l2.9-7.3 2.3 9.2Z" fill="#fc6d26" />
        <path d="M12 21.5 7.4 11.5h9.2Z" fill="#e24329" />
        <path d="M2.2 13.4 7.4 11.5 12 21.5ZM21.8 13.4l-5.2-1.9L12 21.5Z" fill="#fca326" />
      </>
    ) : kind === "bitbucket" ? (
      <path
        fill-rule="evenodd"
        d="M2.8 3h18.4c.5 0 .9.4.8.9l-2.6 16.2c-.1.5-.5.9-1 .9H5.6c-.5 0-.9-.4-1-.9L2 3.9c-.1-.5.3-.9.8-.9Zm6.6 6.2.9 5.6h3.4l.9-5.6Z"
        fill="#2684ff"
      />
    ) : (
      <>
        <path
          d="M3 7.5h14.5v4.2c0 4.4-3 7.8-7.2 7.8S3 16.1 3 11.7Z"
          fill="#609926"
        />
        <path
          d="M17.5 9h1.6a2.4 2.4 0 0 1 0 4.8h-2"
          fill="none"
          stroke="#609926"
          stroke-width="1.8"
          stroke-linecap="round"
        />
        <path d="M7.5 11.3 10.2 14l3.5-4" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </>
    )
  }
</svg>
