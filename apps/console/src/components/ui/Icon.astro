---
import { type IconName, iconInner } from "../../lib/icons.ts";

interface Props {
  name: IconName;
  class?: string;
  /** Only for icons that carry meaning on their own; decorative icons stay hidden. */
  label?: string;
  size?: number;
  /** Draw a centred square of the 24-unit grid this wide, so the glyph fills more of its box
   * (the navigation icons use 22, spec 21.10). */
  box?: number;
}

const { name, class: className, label, size = 16, box = 24 } = Astro.props;
const offset = (24 - box) / 2;
---

<svg
  class={className}
  viewBox={`${offset} ${offset} ${box} ${box}`}
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"
  set:html={iconInner(name)}
/>
