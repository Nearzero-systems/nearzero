---
import type { UploadedCertificate } from "../../lib/data/index.ts";
import Button from "../ui/Button.astro";
import EmptyState from "../ui/EmptyState.astro";
import TableWrap from "../ui/TableWrap.astro";

/**
 * The Uploaded certificates tab (spec 10.7): Name, Covers, Server, Expires ("Expires in N days"
 * within 30 days; red when expired), Edit and Delete.
 */
interface Props {
  certificates: UploadedCertificate[];
  canManage: boolean;
}

const { certificates, canManage } = Astro.props;
---

{
  certificates.length === 0 ? (
    <EmptyState title="No uploaded certificates" text="Only for wildcards or your own CA. Every other hostname gets a free Let's Encrypt certificate.">
      {canManage && <Button variant="primary" data-dialog-open="nz-certificate-upload">Upload certificate</Button>}
    </EmptyState>
  ) : (
    <TableWrap label="Uploaded certificates" class="nz-settings-table nz-domain-tab-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Covers</th>
          <th>Server</th>
          <th>Expires</th>
          <th class="nz-col-actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        {certificates.map((certificate) => (
          <tr>
            <td class="font-medium">{certificate.name}</td>
            <td class="nz-small">{certificate.covers.join(", ")}</td>
            <td>{certificate.server.name}</td>
            <td class:list={[certificate.expired && "nz-danger-text"]}>
              {certificate.expiresNote ?? new Date(certificate.expiresAt).toISOString().slice(0, 10)}
            </td>
            <td class="nz-col-actions">
              {canManage && (
                <span class="nz-backup-actions">
                  <Button
                    variant="ghost"
                    data-dialog-open="nz-certificate-edit"
                    data-dialog-fill={JSON.stringify({ certificateId: certificate.id, name: certificate.name })}
                  >
                    Edit
                  </Button>
                  <Button
                    variant="ghost"
                    data-dialog-open="nz-certificate-delete"
                    data-dialog-fill={JSON.stringify({ certificateId: certificate.id, name: certificate.name })}
                  >
                    Delete
                  </Button>
                </span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </TableWrap>
  )
}
