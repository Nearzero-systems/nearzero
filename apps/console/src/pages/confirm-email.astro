---
import AuthFrame from "../components/auth/AuthFrame.astro";
import Button from "../components/ui/Button.astro";
import FocusLayout from "../layouts/FocusLayout.astro";
import { isApiError } from "../lib/api-error.ts";
import { consoleData } from "../lib/data/index.ts";
import { signInPath } from "../lib/next-step.ts";
import { sessionOrUnavailable } from "../lib/page.ts";
import { dashboardPath } from "../lib/routes.ts";

// Opening the link that confirms an email address (spec 4.6, 30a R1-02). It works only signed in
// as the account it was sent for: signed out, sign-in comes first and brings the person back
// here. Opening it is the confirmation; a link works once, for 24 hours.
const data = consoleData(Astro);
const token = Astro.url.searchParams.get("token")?.trim() ?? "";
const session = await sessionOrUnavailable(Astro);
if (session instanceof Response) return session;
if (!session.signedIn) {
  return Astro.redirect(
    signInPath(token ? `/confirm-email?token=${encodeURIComponent(token)}` : "/confirm-email"),
  );
}

let heading = "Email address confirmed";
let note = "";
let ok = true;
if (token.length < 16) {
  ok = false;
  heading = "This link is incomplete";
  note = "Open the whole link from the email, or ask for a new one from your profile.";
} else {
  try {
    const result = await data.confirmEmail(token);
    heading = result.changed ? "Email address changed" : "Email address confirmed";
    note = result.message;
  } catch (error) {
    if (!isApiError(error)) throw error;
    if (error.code === "control_unreachable") return Astro.rewrite("/unavailable");
    ok = false;
    heading = "This link can't be used";
    note = error.message;
  }
}
const profile = session.workspace ? dashboardPath(session.workspace.slug, "profile") : "/";
---

<FocusLayout title="Confirm email" description="Confirm the email address of your Nearzero account.">
  <AuthFrame heading={heading}>
    <p slot="note" data-confirm-email={ok ? "confirmed" : "refused"}>{note}</p>
    <div class="nz-gate-actions nz-gate-actions--block">
      <Button variant={ok ? "primary" : "outline"} href={profile}>Go to your profile</Button>
    </div>
  </AuthFrame>
</FocusLayout>
