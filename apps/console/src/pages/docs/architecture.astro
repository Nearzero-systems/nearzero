---
// biome-ignore-all lint/correctness/noUnusedImports: Astro resolves frontmatter bindings in the template.
import ControlPlaneDiagram from "@/components/marketing/ControlPlaneDiagram.astro";
import DocCallout from "@/components/marketing/DocCallout.astro";
import DocsShell from "@/components/marketing/DocsShell.astro";
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { publicSiteLinks } from "@/lib/public-site";
---

<MarketingLayout
	kind="article"
	title="Nearzero architecture — Your servers run the apps"
	description="Nearzero is the control plane. Docker, Traefik, and databases run on Linux servers you operate — the same host or remote boxes you add over SSH."
	breadcrumbLabel="Architecture"
>
	<DocsShell
		title="Your servers run the apps. Nearzero is the control plane."
		summary="Install Nearzero on a Linux host. Console, API, and the Agent all call one guarded API. Docker, Traefik, and databases run on that host — or on remote servers you add over SSH."
		activePath={publicSiteLinks.architecture}
		toc={[
			{ href: "#model", label: "Operating model" },
			{ href: "#diagram", label: "Control-plane diagram" },
			{ href: "#boundaries", label: "Trust boundaries" },
			{ href: "#next", label: "Next steps" },
		]}
		previous={{ href: publicSiteLinks.docs, label: "Documentation home" }}
		next={{ href: publicSiteLinks.selfHosting, label: "Self-host Nearzero" }}
	>
		<section id="model" class="nz-doc-section">
			<span class="nz-doc-section__index">01</span>
			<h2>Operating model</h2>
			<p>
				The <strong>control plane</strong> keeps projects, environments, deploys,
				domains, RBAC, and Agent policy together. <strong>Workload hosts</strong>
				run Docker, Traefik, and the databases you place on them. That can be
				the same machine, or another VPS you connect over SSH.
			</p>
			<div class="nz-doc-feature-list">
				<div>
					<strong>Control-plane host</strong>
					<p>
						Runs Nearzero: console, monitoring, schedule jobs, and optional
						CoreDNS.
					</p>
				</div>
				<div>
					<strong>Workload servers</strong>
					<p>
						This host, or remote Linux nodes over SSH. Each service targets one
						server for routing and DNS.
					</p>
				</div>
				<div>
					<strong>Intents</strong>
					<p>
						Console, CLI/API, and the Agent all call the same API. Production
						Agent writes stay off until an administrator turns that gate on.
					</p>
				</div>
				<div>
					<strong>Your infrastructure</strong>
					<p>
						Nearzero does not replace your cloud account. It deploys onto hosts
						you already pay for.
					</p>
				</div>
			</div>
		</section>

		<section id="diagram" class="nz-doc-section">
			<span class="nz-doc-section__index">02</span>
			<h2>Control-plane diagram</h2>
			<p>
				You send an intent on the left. Nearzero applies deploy paths, policy,
				and access control in the center. The work lands on <strong>your
				servers</strong> on the right.
			</p>
			<div class="nz-doc-diagram-wrap">
				<ControlPlaneDiagram compact />
			</div>
		</section>

		<section id="boundaries" class="nz-doc-section">
			<span class="nz-doc-section__index">03</span>
			<h2>Trust boundaries</h2>
			<DocCallout title="Do not put the control plane on the public internet as plain HTTP" tone="critical">
				<p>
					Ports 3000 and 4321 are not a public product edge. Put TLS in front of
					them, or bind them to a management network, before production use.
				</p>
			</DocCallout>
			<div class="nz-doc-feature-list">
				<div>
					<strong>Remote servers are root-equivalent</strong>
					<p>
						SSH setup accounts with Docker access can control the host. Use a
						dedicated identity and verify the first host-key fingerprint.
					</p>
				</div>
				<div>
					<strong>DNS vs app servers</strong>
					<p>
						Authoritative CoreDNS belongs on the control-plane host. Remote app
						servers expose Traefik on 80/443, not Nearzero DNS.
					</p>
				</div>
				<div>
					<strong>Agent scope</strong>
					<p>
						The Agent cannot invent privileged paths. It uses scoped tools under
						your role and org policy. Production writes stay off until you enable
						them.
					</p>
				</div>
			</div>
		</section>

		<section id="next" class="nz-doc-section">
			<span class="nz-doc-section__index">04</span>
			<h2>Next steps</h2>
			<div class="nz-doc-card-grid">
				<a class="nz-doc-card" href={publicSiteLinks.selfHosting}>
					<span>01</span>
					<h3>Self-host Nearzero</h3>
					<p>Install with one command, sign in, then add your domain.</p>
					<strong>Open guide →</strong>
				</a>
				<a class="nz-doc-card" href={publicSiteLinks.remoteServers}>
					<span>02</span>
					<h3>Connect remote servers</h3>
					<p>Add a Linux VPS over SSH. Send public traffic to Traefik on that box.</p>
					<strong>Open guide →</strong>
				</a>
				<a class="nz-doc-card" href={publicSiteLinks.domainsAndHttps}>
					<span>03</span>
					<h3>Domains and HTTPS</h3>
					<p>Point the hostname at the server that runs the app.</p>
					<strong>Open guide →</strong>
				</a>
				<a class="nz-doc-card" href={publicSiteLinks.agentSafety}>
					<span>04</span>
					<h3>Agent safety</h3>
					<p>The Agent can see your infra. Production writes start off.</p>
					<strong>Open guide →</strong>
				</a>
			</div>
		</section>
	</DocsShell>
</MarketingLayout>

<style is:global>
	.nz-doc-diagram-wrap {
		margin-top: 20px;
		max-width: 100%;
		min-width: 0;
		overflow: hidden;
	}
</style>
