---
// biome-ignore-all lint/correctness/noUnusedImports: Astro resolves frontmatter bindings in the template.
import DocCallout from "@/components/marketing/DocCallout.astro";
import DocsShell from "@/components/marketing/DocsShell.astro";
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { docsNavigation, publicSiteLinks } from "@/lib/public-site";

const guideCards = docsNavigation.slice(1);
---

<MarketingLayout
	kind="article"
	title="Nearzero docs — Install the control plane on your VPS"
	description="Install Nearzero on a Linux VPS, add remote servers, route domains with Traefik and Let's Encrypt, and use an Agent that cannot change production until you turn that on."
>
	<DocsShell
		title="Install Nearzero. Then take Git to HTTPS."
		summary="These guides put the control plane on a Linux VPS you operate, then connect servers, domains, and a locked-down Agent."
		activePath={publicSiteLinks.docs}
		toc={[
			{ href: "#choose-a-path", label: "Start here" },
			{ href: "#deployment-model", label: "How it runs" },
			{ href: "#security-baseline", label: "Lock it down" },
		]}
		next={{ href: publicSiteLinks.architecture, label: "Architecture" }}
	>
		<section id="choose-a-path" class="nz-doc-section">
			<span class="nz-doc-section__index">01</span>
			<h2>Start with the control plane</h2>
			<p class="nz-doc-lede">
				Install Nearzero on a dedicated Linux host. Then add workload servers
				and public hostnames. Read the security notes before you expose
				management ports or turn the Agent on for production.
			</p>

			<div class="nz-doc-card-grid">
				{
					guideCards.map((guide, index) => (
						<a class="nz-doc-card" href={guide.href}>
							<span>{String(index + 1).padStart(2, "0")}</span>
							<h3>{guide.label}</h3>
							<p>{guide.description}</p>
							<strong>Open guide →</strong>
						</a>
					))
				}
			</div>
		</section>

		<section id="deployment-model" class="nz-doc-section">
			<span class="nz-doc-section__index">02</span>
			<h2>Your servers run the apps</h2>
			<p>
				Nearzero is the control plane. Docker, Traefik, and databases run on
				Linux you operate. One host can do both jobs. When you add another VPS,
				workloads move there. Projects, deploys, DNS, and Agent policy stay on
				the control plane.
			</p>

			<figure class="nz-doc-flow">
				<figcaption class="nz-visually-hidden">Nearzero deployment model from control plane to runtime hosts and public routing.</figcaption>
				<div><small>Control plane</small><strong>Console + API</strong><span>Projects, policy, DNS</span></div>
				<i aria-hidden="true">→</i>
				<div><small>Runtime hosts</small><strong>Local or remote</strong><span>Apps, data, Compose</span></div>
				<i aria-hidden="true">→</i>
				<div><small>Public edge</small><strong>DNS + Traefik</strong><span>Hostnames and HTTPS</span></div>
			</figure>

			<div class="nz-doc-feature-list">
				<div><strong>Control-plane host</strong><p>Runs Nearzero: console, API, monitoring, and optional CoreDNS.</p></div>
				<div><strong>Workload servers</strong><p>Run Traefik and the apps you place on them. They do not run Nearzero DNS.</p></div>
				<div><strong>Managed zones</strong><p>Nearzero writes an A record to the server selected for that service.</p></div>
				<div><strong>Agent</strong><p>Can read deploys, logs, and servers. Production writes stay off until you turn that gate on.</p></div>
			</div>
			<p>
				<a class="nz-text-link" href={publicSiteLinks.architecture}>
					See the full control-plane diagram <span aria-hidden="true">→</span>
				</a>
			</p>
		</section>

		<section id="security-baseline" class="nz-doc-section">
			<span class="nz-doc-section__index">03</span>
			<h2>Lock the management plane down first</h2>
			<DocCallout title="The installer does not put TLS on ports 3000 and 4321" tone="critical">
				<p>
					Ports 3000 and 4321 are plain HTTP. Keep them on a management network,
					behind a VPN or firewall, or publish them only through an authenticated
					HTTPS reverse proxy. Do not send login credentials over a public
					plaintext listener.
				</p>
			</DocCallout>

			<ul class="nz-doc-checklist">
				<li><span>1</span><div><strong>Use a dedicated control-plane host.</strong><p>Its Docker socket and stored credentials are privileged infrastructure.</p></div></li>
				<li><span>2</span><div><strong>Verify the installer checksum.</strong><p>Download the versioned script and published SHA-256 file before execution.</p></div></li>
				<li><span>3</span><div><strong>Restrict SSH and management access.</strong><p>Allow only administrative source ranges and protect the dedicated server key.</p></div></li>
				<li><span>4</span><div><strong>Back up Postgres and privileged configuration.</strong><p>Encrypt off-host backups and test restoration before production use.</p></div></li>
			</ul>
		</section>
	</DocsShell>
</MarketingLayout>
