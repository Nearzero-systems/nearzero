---
import {
  APP_NAME_BASE_MAX,
  DESCRIPTION_MAX,
  GIT_PROVIDER_LABELS,
  noAccountsMessage,
  SERVICE_NAME_MAX,
} from "@nearzero/shared/browser";
import BuildPanel from "../../../../../../components/deploys/BuildPanel.astro";
import Button from "../../../../../../components/ui/Button.astro";
import Field from "../../../../../../components/ui/Field.astro";
import FormError from "../../../../../../components/ui/FormError.astro";
import Icon from "../../../../../../components/ui/Icon.astro";
import ProjectLayout from "../../../../../../layouts/ProjectLayout.astro";
import { connectPath, PROVIDER_ORDER, withProvider } from "../../../../../../lib/git-providers.ts";
import { GIT_URL_MESSAGE } from "../../../../../../lib/new-application.ts";
import { dashboardContext } from "../../../../../../lib/page.ts";
import { loadProjectPage } from "../../../../../../lib/project-page.ts";
import { NO_SERVER_MESSAGE, serverChoices } from "../../../../../../lib/projects.ts";
import { dashboardPath, projectPath, settingsPath } from "../../../../../../lib/routes.ts";

// "Create a new application" (spec 06 6.1, 21.10): "← Overview", the centred title and "Create
// without Git" in the top row; then a centred 350px column with the four providers as large
// buttons, "OR", the public repository URL and Continue. Picking a provider goes on to
// Repository → Configure; "Create without Git" swaps in the container image form. Create &
// deploy follows the first deploy in the build panel (client/build-panel.ts).
const ctx = await dashboardContext(Astro);
if (ctx instanceof Response) return ctx;
const page = await loadProjectPage(Astro, ctx);
if (page instanceof Response) return page;
const { project, environment } = page;
const slug = ctx.workspace.slug;
if (!environment.can.createService)
  return Astro.redirect(projectPath(slug, project.id, environment.id));
const servers = serverChoices(await ctx.data.targets());
const serviceBase = `${dashboardPath(slug, `projects/${encodeURIComponent(project.id)}/${encodeURIComponent(environment.id)}/services`)}/`;
const overview = projectPath(slug, project.id, environment.id);
const gitProviders = settingsPath(slug, "git-providers");
// The Provider step's accounts (spec 6.1): the ones this person may use, by host. "Connect
// account" opens Settings → Git providers and comes back here with that host chosen.
const usable = await ctx.data
  .usableGitProviders()
  .catch(() => ({ providers: [], canConnect: false }));
const here = Astro.url.pathname;
const chosen = Astro.url.searchParams.get("provider");
const accounts = usable.providers.filter((provider) => provider.ready);
const byKind = PROVIDER_ORDER.map((kind) => ({
  kind,
  label: GIT_PROVIDER_LABELS[kind],
  accounts: accounts.filter((provider) => provider.kind === kind),
  pending: usable.providers.filter((provider) => provider.kind === kind && !provider.ready).length,
}));
// Create & deploy is for people who may deploy what they create here (spec 6.1); the others
// get Create application as the main button.
const canDeploy = environment.can.deployNewService !== false;
const serverOptions = servers.map((server, index) => ({
  value: server.id,
  label: server.label,
  selected: index === 0,
}));
---

<ProjectLayout page={page} section="new-application" title="New application" menu={false}>
  <div
    class="nz-new-app nz-body"
    data-new-app
    data-project-name={project.name}
    data-git-accounts={JSON.stringify(accounts)}
    data-git-chosen={chosen ?? ""}
    data-environment-id={environment.id}
    data-service-base={serviceBase}
  >
    <div class="nz-newapp-top">
      <a class="nz-newapp-back" href={overview}><Icon name="arrow-left" size={12} />Overview</a>
      <h1 class="nz-newapp-title">Create a new application</h1>
      <label class="nz-newapp-mode" for="nz-app-without-git" data-app-mode>
        <input type="checkbox" id="nz-app-without-git" class="nz-newapp-mode-input" data-app-without-git />
        <span class="nz-newapp-mode-off">Create without Git</span>
        <span class="nz-newapp-mode-on">Create from Git</span>
      </label>
    </div>

    <BuildPanel />

    <div data-app-git class="nz-newapp-git">
      <ol class="nz-stepper" aria-label="Steps">
        <li class="nz-step" data-step-mark="provider" aria-current="step">Provider</li>
        <li class="nz-step-sep" aria-hidden="true"><Icon name="chevron-right" /></li>
        <li class="nz-step" data-step-mark="repository">Repository</li>
        <li class="nz-step-sep" aria-hidden="true"><Icon name="chevron-right" /></li>
        <li class="nz-step" data-step-mark="configure">Configure</li>
      </ol>

      <div data-step="provider" class="nz-newapp-column">
        <p class="nz-newapp-intro">
          Connect a Git provider or paste a public repository URL to deploy in this environment.
        </p>
        <div class="nz-newapp-providers">
          {
            byKind.map((item) => {
              const message =
                item.accounts.length > 0
                  ? `${item.accounts.length === 1 ? "1 account" : `${item.accounts.length} accounts`}: ${item.accounts
                      .slice(0, 3)
                      .map((account) => (account.account ? `${account.name} · ${account.account}` : account.name))
                      .join(", ")}${item.accounts.length > 3 ? ` and ${item.accounts.length - 3} more` : ""}.`
                  : `${noAccountsMessage(item.kind)}${item.pending > 0 ? " An account is waiting to finish connecting in Git providers." : ""}`;
              const logo = (
                <span class="nz-newapp-logo" data-logo={item.kind} aria-hidden="true">
                  {item.kind === "github" ? (
                    <svg viewBox="0 0 20 20" width="20" height="20">
                      <path fill="currentColor" d="M3.6 8.2 4.3 3.2l3.4 2.3a7 7 0 0 1 4.6 0l3.4-2.3.7 5a6.6 6.6 0 0 1-6.4 9.3 6.6 6.6 0 0 1-6.4-9.3Z" />
                      <path class="nz-logo-eyes" d="M7.2 10.2h1.4v1.6H7.2Zm4.2 0h1.4v1.6h-1.4Z" />
                    </svg>
                  ) : item.kind === "gitlab" ? (
                    <svg viewBox="0 0 20 20" width="20" height="20">
                      <path fill="#e24329" d="M10 17.5 3 11.2l1.6-7.7 2 5.4h6.8l2-5.4 1.6 7.7Z" />
                      <path fill="#fc6d26" d="M10 17.5 6.6 8.9H3.8L3 11.2Zm0 0 3.4-8.6h2.8l.8 2.3Z" />
                      <path fill="#fca326" d="M10 17.5 6.6 8.9h6.8Z" />
                    </svg>
                  ) : item.kind === "bitbucket" ? (
                    <svg viewBox="0 0 20 20" width="20" height="20">
                      <rect x="3" y="3" width="14" height="14" rx="2" fill="#0052cc" />
                      <path fill="#ffffff" d="M6.2 6h7.6l-1 7.2H7.2Zm2.3 2.2.4 3h2.2l.4-3Z" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 20 20" width="20" height="20">
                      <path fill="#609926" d="M3 6.5h10.5v4.2a4.3 4.3 0 0 1-4.3 4.3H7.3A4.3 4.3 0 0 1 3 10.7Z" />
                      <path fill="none" stroke="#609926" stroke-width="1.6" d="M13.5 7.6h1.4a1.9 1.9 0 0 1 0 3.8h-1.6" />
                      <path fill="#ffffff" d="M6.4 9.3h1.2v2.4H6.4Zm2.2-.8h1.2v3.2H8.6Z" />
                    </svg>
                  )}
                </span>
              );
              return (
                <div class="nz-newapp-provider" data-provider-card={item.kind}>
                  {item.accounts.length > 0 ? (
                    <button type="button" class="nz-newapp-provider-btn" data-git-pick-kind={item.kind} title={message}>
                      {logo}
                      <span>{item.label}</span>
                      <span class="nz-visually-hidden">{message} Choose repository</span>
                    </button>
                  ) : usable.canConnect ? (
                    <a class="nz-newapp-provider-btn" href={connectPath(slug, item.kind, withProvider(here, item.kind))} title={message}>
                      {logo}
                      <span>{item.label}</span>
                      <span class="nz-visually-hidden">{message} Connect account</span>
                    </a>
                  ) : usable.providers.length > 0 ? (
                    <a class="nz-newapp-provider-btn" href={gitProviders} title={message}>
                      {logo}
                      <span>{item.label}</span>
                      <span class="nz-visually-hidden">{message} Git provider settings</span>
                    </a>
                  ) : (
                    <button type="button" class="nz-newapp-provider-btn" disabled title={message}>
                      {logo}
                      <span>{item.label}</span>
                      <span class="nz-visually-hidden">{message}</span>
                    </button>
                  )}
                </div>
              );
            })
          }
        </div>
        <p class="nz-or" aria-hidden="true">OR</p>
        <form data-scripted class="nz-form nz-form--flush" data-app-public-url novalidate>
          <div data-field>
            <label for="nz-app-repo-url" class="nz-label">Public repository URL</label>
            <input
              id="nz-app-repo-url"
              name="repositoryUrl"
              class="nz-input nz-input--filled"
              placeholder="https://github.com/owner/repo"
              title="Any host over HTTPS, or git@host:owner/repo. Continue looks up the default branch; you can change it after."
              autocomplete="off"
              spellcheck="false"
              inputmode="url"
              data-message={GIT_URL_MESSAGE}
            />
            <p class="nz-field-error" data-field-error hidden></p>
          </div>
          <Button variant="primary" type="submit" block>Continue</Button>
        </form>
      </div>

      <div data-step="repository" class="nz-app-form" hidden data-git-repository-step>
        <div class="nz-form-grid-2">
          <Field id="nz-app-account" label="Account" as="select" options={[]} data-git-account />
          <div data-field>
            <label for="nz-app-filter" class="nz-label">Repositories</label>
            <label class="nz-input-icon">
              <Icon name="search" />
              <input
                id="nz-app-filter"
                class="nz-input"
                type="search"
                placeholder="Filter repositories…"
                autocomplete="off"
                spellcheck="false"
                data-git-filter
              />
            </label>
          </div>
        </div>
        <p class="nz-hint mt-3" data-git-repo-note aria-live="polite"></p>
        <div class="nz-git-repo-list mt-2" data-git-repo-list></div>
        <div class="nz-form-actions mt-3">
          <Button variant="outline" data-step-go="provider">Back</Button>
        </div>
      </div>

      <form data-scripted class="nz-form nz-app-form" data-step="configure" data-app-configure hidden novalidate>
        <p class="nz-inline-note" data-branch-note aria-live="polite" hidden></p>
        <div class="nz-form-grid-2">
          <Field id="nz-app-repo" name="repository" label="Repository" readonly />
          <Field id="nz-app-branch" name="branch" label="Branch" value="main" autocomplete="off" spellcheck="false" list="nz-app-branches" data-git-branch />
          <Field id="nz-app-display" name="name" label="Display name" autocomplete="off" maxlength={SERVICE_NAME_MAX} data-service-name />
          <Field
            id="nz-app-appname"
            name="appName"
            label="App name"
            autocomplete="off"
            spellcheck="false"
            maxlength={APP_NAME_BASE_MAX}
            hint="A unique suffix is added automatically."
            data-app-name
          />
          <Field
            id="nz-app-build-path"
            name="buildPath"
            label="Build path"
            as="select"
            options={[
              { value: "/", label: "/ (repository root)", selected: true },
              { value: "custom", label: "Custom build path" },
            ]}
            hint="For monorepos: pick the app's folder. Folders with a Dockerfile come first."
            data-git-build-path
          />
          <div data-git-custom-path hidden>
            <Field
              id="nz-app-build-path-custom"
              name="customBuildPath"
              label="Custom build path"
              placeholder="apps/web"
              autocomplete="off"
              spellcheck="false"
            />
          </div>
          {
            servers.length > 0 ? (
              <Field id="nz-app-server" name="serverId" label="Server" as="select" options={serverOptions} />
            ) : (
              <div data-field>
                <span class="nz-label">Server</span>
                <p class="nz-inline-note">{NO_SERVER_MESSAGE}</p>
              </div>
            )
          }
        </div>
        <Field id="nz-app-description" name="description" label="Description" as="textarea" rows={2} maxlength={DESCRIPTION_MAX} />
        <fieldset class="nz-choice-list" data-app-domain>
          <legend class="nz-label">Domain</legend>
          <p class="nz-dim nz-wrap-any" data-app-hostname-preview aria-live="polite">Checking which hostname the first deploy gives it…</p>
          <p class="nz-small nz-dim nz-wrap-any" data-app-hostname-record hidden></p>
          <label class="nz-check-row" data-app-zone-option hidden>
            <input type="checkbox" name="alsoZone" value="1" data-app-zone-check />
            <span class="min-w-0">
              <span>Also assign a hostname from the workspace's DNS zone</span>
              <span class="nz-small nz-dim nz-wrap-any block" data-app-zone-hostname></span>
            </span>
          </label>
          <div class="nz-form-grid-2">
            <Field
              id="nz-app-port"
              name="servicePort"
              label="Service port"
              value=""
              placeholder="From the image"
              hint="Leave it empty to use the port the image declares (3000 when it declares none)."
              inputmode="numeric"
              data-port
            />
          </div>
        </fieldset>
        <details class="nz-collapsible">
          <summary>
            <span class="nz-label">Advanced build commands</span>
            <Icon name="chevron-down" />
          </summary>
          <div class="nz-form-grid-2">
            <Field id="nz-app-install" name="installCommand" label="Install" placeholder="Optional" autocomplete="off" spellcheck="false" />
            <Field id="nz-app-build" name="buildCommand" label="Build" placeholder="Optional" autocomplete="off" spellcheck="false" />
            <Field id="nz-app-start" name="startCommand" label="Start" placeholder="Optional" autocomplete="off" spellcheck="false" />
          </div>
        </details>
        <fieldset class="nz-choice-list">
          <legend class="nz-label">Environment variables</legend>
          <div class="nz-env-rows" data-app-env-rows></div>
          <div class="flex flex-wrap gap-2">
            <Button variant="outline" icon="plus" data-app-env-add>Add variable</Button>
            <Button variant="outline" data-app-env-paste-toggle>Paste .env format</Button>
          </div>
          <div data-app-env-paste hidden class="nz-stack-sm">
            <textarea class="nz-textarea nz-code-input" rows="4" aria-label="Paste .env text" placeholder="API_URL=https://api.example.com" data-app-env-paste-text></textarea>
            <div><Button variant="outline" data-app-env-paste-apply>Add these</Button></div>
          </div>
          <div class="nz-stack-sm" data-app-env-notes></div>
          <p class="nz-hint">Builds start in automatic mode: a Dockerfile at the build path is used; otherwise the language is detected. You can change the builder afterwards.</p>
        </fieldset>
        <datalist id="nz-app-branches" data-git-branches></datalist>
        <p class="nz-inline-note nz-warn-note" data-app-setup-failed hidden></p>
        <FormError />
        <div class="nz-form-actions">
          <Button variant="outline" data-step-go="provider">Back</Button>
          <Button variant={canDeploy ? "outline" : "primary"} type="submit" disabled={servers.length === 0}>Create application</Button>
          {canDeploy && <Button variant="primary" type="submit" data-and-deploy disabled={servers.length === 0}>Create &amp; deploy</Button>}
        </div>
      </form>
    </div>

    <form data-scripted
      class="nz-form nz-app-form"
      data-app-image
      data-create-service="application"
      data-environment-id={environment.id}
      data-project-name={project.name}
      data-service-base={serviceBase}
      hidden
      novalidate
    >
      <input type="hidden" name="kind" value="application" />
      <div class="nz-form-grid-2">
        <Field
          id="nz-app-image-name"
          name="name"
          label="Name"
          autocomplete="off"
          maxlength={SERVICE_NAME_MAX}
          data-required="Enter a name for the service."
        />
        {
          servers.length > 0 ? (
            <Field id="nz-app-image-server" name="serverId" label="Server" as="select" options={serverOptions} />
          ) : (
            <div data-field>
              <span class="nz-label">Server</span>
              <p class="nz-inline-note">{NO_SERVER_MESSAGE}</p>
            </div>
          )
        }
        <Field
          id="nz-app-image-appname"
          name="appName"
          label="App name"
          autocomplete="off"
          spellcheck="false"
          maxlength={APP_NAME_BASE_MAX}
          hint="A unique suffix is added automatically."
          data-app-name
        />
        <Field
          id="nz-app-image-image"
          name="settings.image"
          label="Container image"
          placeholder="nginx:alpine"
          autocomplete="off"
          spellcheck="false"
          hint={'Optional. For example "nginx:alpine" or "ghcr.io/acme/api:1.2.0", with no spaces.'}
          data-image
        />
      </div>
      <Field id="nz-app-image-description" name="description" label="Description" as="textarea" rows={2} maxlength={DESCRIPTION_MAX} />
      <FormError />
      <div class="nz-form-actions">
        <Button variant="outline" type="submit" disabled={servers.length === 0}>Create application</Button>
        <Button variant="primary" type="submit" data-and-deploy disabled={servers.length === 0}>Create &amp; deploy</Button>
      </div>
    </form>
  </div>
</ProjectLayout>
