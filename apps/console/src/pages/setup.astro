---
// biome-ignore-all lint/correctness/noUnusedImports: Astro resolves frontmatter bindings in the template.
import SetupGrid from "@/components/auth/SetupGrid.astro";
import Base from "@/layouts/Base.astro";
import { getSession } from "@/lib/backendProxy";
import { pageTitle } from "@/lib/branding";
import {
	isInstallSetupPageOpen,
	parseInstallSetupStep,
} from "@/lib/install-setup";
import {
	fetchInstallBootstrapStatusServer,
	fetchInstallSetupStatusServer,
	hasInstallSetupSessionServer,
} from "@/lib/install-setup-server";

const session = await getSession(Astro.request);
if (session?.user) {
	return Astro.redirect("/dashboard/agent");
}

const bootstrap = await fetchInstallBootstrapStatusServer();
if (bootstrap && bootstrap.nextSurface !== "setup") {
	return Astro.redirect(`/${bootstrap.nextSurface}`);
}

const setupSessionAuthorized = await hasInstallSetupSessionServer(Astro.request);
const status = setupSessionAuthorized
	? await fetchInstallSetupStatusServer(Astro.request)
	: null;
const wizardAuthorized = Boolean(
	setupSessionAuthorized && status && isInstallSetupPageOpen(status),
);

const requested = parseInstallSetupStep(Astro.url.searchParams.get("step"));
const requestedPendingStep =
	requested === "welcome" ||
	requested === "management" ||
	requested === "zone" ||
	requested === "review"
		? requested
		: null;
const initialStep =
	requestedPendingStep ??
	(status?.resumeStep === "welcome" ||
	status?.resumeStep === "management" ||
	status?.resumeStep === "zone" ||
	status?.resumeStep === "review" ||
	status?.resumeStep === "verify" ||
	status?.resumeStep === "done"
		? status.resumeStep
		: "welcome");
const initialAccessError =
	bootstrap === null || (setupSessionAuthorized && !status)
		? "unavailable"
		: null;
---

<Base title={pageTitle("Setup")} forceLightTheme>
	<SetupGrid
		status={status}
		initialStep={initialStep}
		setupSessionAuthorized={wizardAuthorized}
		initialAccessError={initialAccessError}
	/>
</Base>
