---
// biome-ignore-all lint/correctness/noUnusedImports: Astro resolves frontmatter bindings in the template.
import SetupGrid from "@/components/auth/SetupGrid.astro";
import Base from "@/layouts/Base.astro";
import { getSession } from "@/lib/backendProxy";
import { pageTitle } from "@/lib/branding";
import {
	extractSetupToken,
	INSTALL_SETUP_SESSION_COOKIE,
	isInstallSetupPageOpen,
	isLoopbackHostname,
	parseInstallSetupStep,
	resolveInstallSetupPath,
} from "@/lib/install-setup";
import {
	fetchInstallSetupStatusServer,
	resolveLoopbackInstallSetupToken,
	verifyInstallSetupSessionToken,
} from "@/lib/install-setup-server";

const session = await getSession(Astro.request);
if (session?.user) {
	return Astro.redirect("/dashboard/agent");
}

const status = await fetchInstallSetupStatusServer(Astro.request);
if (!status || !isInstallSetupPageOpen(status)) {
	Astro.cookies.delete(INSTALL_SETUP_SESSION_COOKIE, { path: "/" });
	return Astro.redirect(resolveInstallSetupPath(status) ?? "/login");
}

const queryToken = extractSetupToken(Astro.url.searchParams.get("token") || "");
const existingSetupCookie = Astro.cookies.get(INSTALL_SETUP_SESSION_COOKIE)
	?.value;
const loopbackToken =
	!queryToken && !existingSetupCookie && isLoopbackHostname(Astro.url.hostname)
		? resolveLoopbackInstallSetupToken()
		: null;
const sessionToken = queryToken || loopbackToken;
if (sessionToken && (await verifyInstallSetupSessionToken(sessionToken))) {
	Astro.cookies.set(INSTALL_SETUP_SESSION_COOKIE, sessionToken, {
		path: "/",
		httpOnly: true,
		sameSite: "strict",
		maxAge: 60 * 60 * 24,
		secure: Astro.url.protocol === "https:",
	});
	if (queryToken) {
		const next = new URL(Astro.url);
		next.searchParams.delete("token");
		return Astro.redirect(`${next.pathname}${next.search}`);
	}
}

const requested = parseInstallSetupStep(Astro.url.searchParams.get("step"));
const requestedPendingStep =
	requested === "welcome" ||
	requested === "management" ||
	requested === "zone" ||
	requested === "review"
		? requested
		: null;
const initialStep =
	requestedPendingStep ??
	(status.resumeStep === "welcome" ||
	status.resumeStep === "management" ||
	status.resumeStep === "zone"
		? status.resumeStep
		: "welcome");
---

<Base title={pageTitle("Setup")} forceLightTheme>
	<SetupGrid status={status} initialStep={initialStep} />
</Base>
