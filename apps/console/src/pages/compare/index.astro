---
// biome-ignore-all lint/correctness/noUnusedImports: Astro resolves frontmatter bindings in the template.
import LandingBoard from "@/components/marketing/LandingBoard.astro";
import MarketingFaq from "@/components/marketing/MarketingFaq.astro";
import MarketingFooter from "@/components/marketing/MarketingFooter.astro";
import MarketingHeader from "@/components/marketing/MarketingHeader.astro";
import MastheadBoard from "@/components/marketing/MastheadBoard.astro";
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { comparisonGroups, comparisons } from "@/lib/comparisons";
import {
	comparisonNavigation,
	publicSiteLinks,
	publicSiteUrl,
} from "@/lib/public-site";
import "@/styles/landing.css";

const salesUrl = "mailto:contact@nearzero.dev?subject=Nearzero%20walkthrough";

const itemListSchema = {
	"@type": "ItemList",
	name: "Nearzero deployment platform comparisons",
	numberOfItems: comparisons.length,
	itemListElement: comparisons.map((comparison, index) => ({
		"@type": "ListItem",
		position: index + 1,
		name: comparison.title,
		url: publicSiteUrl(`/compare/${comparison.slug}`).toString(),
	})),
};

const cardCopy = Object.fromEntries(
	comparisonNavigation.map((item) => [item.competitor, item.description]),
);

const nearzeroPath = [
	{
		number: "01",
		title: "Control plane",
		copy: "Install Nearzero on a dedicated Linux host you operate.",
	},
	{
		number: "02",
		title: "Servers",
		copy: "Keep work on that host, or add more Linux servers over SSH.",
	},
	{
		number: "03",
		title: "Source",
		copy: "Connect Git. Branch, build command, and runtime stay with the app.",
	},
	{
		number: "04",
		title: "Deploy",
		copy: "Build apps, databases, or Compose on the selected server.",
	},
	{
		number: "05",
		title: "Publish",
		copy: "Point the hostname at that server. Traefik and Let's Encrypt handle HTTPS.",
	},
	{
		number: "06",
		title: "Operate",
		copy: "Logs and metrics stay with the workload. The Agent can look — production writes stay off until you turn them on.",
	},
];

const groupIntros = {
	"managed-platforms": {
		heading: "They own the runtime. You do not get the server.",
		copy: "Vercel and Netlify will not give you a Docker host, a database on your VPS, or a say in which machine the work runs on.",
	},
	"self-hosted-paas": {
		heading: "Same VPS. Different control plane.",
		copy: "Coolify can ship Git to a server. Nearzero keeps placement, optional DNS, HTTPS, metrics, and a locked-down Agent on that host.",
	},
} as const;
---

<MarketingLayout
	kind="collection"
	title="Nearzero vs Vercel, Netlify, and Coolify"
	description="Vercel and Netlify own the runtime. Coolify ships Git to a VPS. Nearzero is the control plane for apps, databases, and Compose on Linux you operate."
	canonical="/compare"
	breadcrumbLabel="Compare"
	socialImageAlt="Nearzero comparison hub: self-hosted deployment versus Vercel, Coolify, and Netlify."
	schemaGraph={[itemListSchema]}
>
	<div class="nz-marketing">
		<MastheadBoard compact>
			<MarketingHeader slot="header" active="compare" />
			<section slot="hero" class="nz-hero" id="main-content" aria-labelledby="nz-compare-hero-heading">
				<div class="nz-container">
					<div class="nz-hero__copy">
						<h1 id="nz-compare-hero-heading">
							Keep the servers. Run the platform on them.
						</h1>
						<p class="nz-hero__lede">
							Nearzero is the control plane for apps, databases, and Compose on Linux you operate. These three pages show what Vercel, Netlify, and Coolify do not give you.
						</p>
						<div class="nz-hero__actions">
							<a class="nz-button nz-button--primary" href="#platforms">
								See the gaps
								<span aria-hidden="true">↓</span>
							</a>
						</div>
					</div>
				</div>
			</section>
		</MastheadBoard>

		<main>
			{
				comparisonGroups.map((group) => (
					<LandingBoard
						kicker={group.id === "managed-platforms" ? "Managed" : "Self-host"}
						headingId={`nz-compare-${group.id}`}
						id={group.id === "managed-platforms" ? "platforms" : group.id}
						bodyClass="nz-land-board__body--split"
					>
						<Fragment slot="intro">
							<h2 id={`nz-compare-${group.id}`}>{groupIntros[group.id].heading}</h2>
							<p>{groupIntros[group.id].copy}</p>
						</Fragment>
						{group.comparisons.map((comparison) => (
							<a class="nz-land-tile nz-land-tile--link" href={`/compare/${comparison.slug}`}>
								<span class="nz-land-tile__kicker">
									{comparison.category === "managed-platform" ? "Managed" : "Self-hosted"}
								</span>
								<h3>Nearzero vs {comparison.competitor}</h3>
								<p>{cardCopy[comparison.competitor] ?? comparison.summary}</p>
								<span class="nz-text-link">
									Why Nearzero <span aria-hidden="true">→</span>
								</span>
							</a>
						))}
					</LandingBoard>
				))
			}

			<LandingBoard kicker="Path" headingId="nz-compare-path-heading" id="nearzero-path" bodyClass="nz-land-board__body--path">
				<Fragment slot="intro">
					<h2 id="nz-compare-path-heading">Host to a running application.</h2>
					<p>Nearzero runs the workflow. You keep the servers.</p>
				</Fragment>
				{
					nearzeroPath.map((step) => (
						<article class="nz-land-tile">
							<span class="nz-land-tile__kicker">{step.number}</span>
							<h3>{step.title}</h3>
							<p>{step.copy}</p>
						</article>
					))
				}
				<article class="nz-land-tile nz-land-tile--wide">
					<div class="nz-land-tile__copy">
						<span class="nz-land-tile__kicker">The point</span>
						<h3>You still patch, back up, and size the VPS.</h3>
						<p>That is how you keep the data, the network path, and the incident. Nearzero builds, deploys, and routes.</p>
					</div>
					<a class="nz-text-link" href={publicSiteLinks.selfHosting}>
						Read the self-hosting guide <span aria-hidden="true">→</span>
					</a>
				</article>
			</LandingBoard>

			<LandingBoard kicker="Call" headingId="nz-compare-walk-heading" id="walkthrough" bodyClass="nz-land-board__body--split">
				<Fragment slot="intro">
					<h2 id="nz-compare-walk-heading">Map this to the servers you have.</h2>
					<p>Thirty minutes against the hosts, DNS, and Compose you actually run.</p>
				</Fragment>
				<article class="nz-land-tile nz-land-tile--cta">
					<div class="nz-land-tile__copy">
						<span class="nz-land-tile__kicker">Book</span>
						<h3>Walk through the comparison.</h3>
						<p>Bring what you run today. We will say when Nearzero is the wrong install.</p>
						<ul class="nz-land-checks">
							<li>Whether you need a Docker host a managed platform does not give you</li>
							<li>Docker, Compose, and where each service should run</li>
							<li>DNS, HTTPS, and who owns the box after deploy</li>
						</ul>
					</div>
					<div class="nz-land-actions">
						<a
							class="nz-button nz-button--primary"
							href={salesUrl}
						>
							Book a 30-minute walkthrough
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</article>
				<article class="nz-land-tile">
					<span class="nz-land-tile__kicker">Format</span>
					<h3>What the half-hour is.</h3>
					<p>A working session, not a pitch deck.</p>
					<ul class="nz-land-checks">
						<li>Current setup and the hosts you already pay for</li>
						<li>Nearzero against those constraints</li>
						<li>Next step: install, or stay where you are</li>
					</ul>
				</article>
			</LandingBoard>

			<LandingBoard kicker="Guides" headingId="nz-compare-next-heading" id="get-started" bodyClass="nz-land-board__body--cta">
				<Fragment slot="intro">
					<h2 id="nz-compare-next-heading">If this pointed at Nearzero, install it.</h2>
					<p>Own the host first. Then put the control plane on it.</p>
				</Fragment>
				<article class="nz-land-tile nz-land-tile--cta">
					<div class="nz-land-tile__copy">
						<span class="nz-land-tile__kicker">Install</span>
						<h3>Self-hosting guide</h3>
						<p>Dedicated Linux host, DNS, HTTPS, and the first deploy.</p>
					</div>
					<div class="nz-land-actions">
						<a class="nz-button nz-button--primary" href={publicSiteLinks.selfHosting}>
							Open the install guide
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</article>
				<article class="nz-land-tile">
					<div class="nz-land-tile__copy">
						<span class="nz-land-tile__kicker">System</span>
						<h3>Architecture</h3>
						<p>Your servers run the apps. Nearzero is the control plane.</p>
					</div>
					<div class="nz-land-actions">
						<a class="nz-button nz-button--secondary" href={publicSiteLinks.architecture}>
							Read the architecture
						</a>
					</div>
				</article>
			</LandingBoard>

			<MarketingFaq />
		</main>

		<MarketingFooter />
	</div>
</MarketingLayout>
